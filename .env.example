# ==========================================
# Clash of Clans Tracker - Configurazione
# ==========================================

# Token JWT ottenuto da https://developer.clashofclans.com
# NOTA: Quando crei la chiave sul portale Supercell, assicurati di inserire
# l'indirizzo IP pubblico della tua macchina / server.
COC_API_TOKEN=

# Porta del server HTTP (predefinita: 3000)
PORT=3000

# Intervallo in minuti per il polling e tracciamento automatico in background
POLL_INTERVAL_MINUTES=15
